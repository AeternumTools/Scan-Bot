# ─────────────────────────────────────────────────────────────────────────────
#  Lumi Bot — Archivo de configuración
#
#  1. Copia este archivo y renómbralo a  ".env"   (sin el .example)
#  2. Rellena los valores.  Solo las variables marcadas como OBLIGATORIAS hacen
#     falta para que el bot arranque; el resto son opcionales.
#
#  IMPORTANTE: el bot lee TODA su configuración desde aquí como respaldo.
#  Si rellenas los IDs de canales/roles en este archivo, NO necesitas volver a
#  usar /configurar en Discord al moverte a otro PC.  (Para mover también tus
#  PROYECTOS y el historial, usa  "npm run backup"  →  "npm run restore".)
# ─────────────────────────────────────────────────────────────────────────────


# ═══ DISCORD (OBLIGATORIO) ═══════════════════════════════════════════════════
# Token del bot → https://discord.com/developers/applications → tu app → Bot
DISCORD_TOKEN=
# Client ID (Application ID) → misma página → General Information
DISCORD_CLIENT_ID=
# ID de tu servidor de STAFF (clic derecho en el servidor → Copiar ID de servidor)
# Necesitas activar Ajustes de Discord → Avanzado → Modo desarrollador
DISCORD_GUILD_ID=
# ID del servidor de LECTORES (opcional, solo si usas un segundo servidor público)
DISCORD_READER_GUILD_ID=


# ═══ IA / GROQ (opcional — habilita la personalidad conversacional de Lumi) ══
# API key gratuita → https://console.groq.com/keys
GROQ_API_KEY=


# ═══ GOOGLE DRIVE (opcional — necesario para el comando /status) ═════════════
# ID de la carpeta raíz en Drive (de la URL: drive.google.com/drive/folders/ESTE_ID)
GDRIVE_ROOT_FOLDER_ID=
#
# --- Opción A: OAuth2 con tu cuenta personal (permite SUBIR archivos a Mi Unidad) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
#
# --- Opción B: Service Account (solo lectura / Shared Drives) ---
# Pega el JSON completo de la cuenta de servicio en una sola línea,
# o deja vacío y coloca el archivo en  config/google-credentials.json
GOOGLE_SERVICE_ACCOUNT_KEY=


# ═══ CANALES (opcional — IDs de canales de Discord) ══════════════════════════
# Rellenar aquí equivale a configurarlos con /configurar, pero persiste solo.
ANNOUNCEMENT_CHANNEL_ID=
RECORDS_CHANNEL_ID=
LOG_CHANNEL_ID=
STAFF_NOTICE_ID=
NOTICE_CHANNEL_ID=
COVERS_CHANNEL_ID=
RAWS_CHANNEL_ID=


# ═══ ROLES (opcional — IDs de roles de Discord) ══════════════════════════════
MOD_ROLE_ID=
ANNOUNCER_ROLE_ID=
# Roles que pueden hablarle a la IA (varios IDs separados por coma)
LUMI_AI_STAFF_ROLE_IDS=
# Tu ID de usuario (trato preferente de la IA hacia el dueño)
VALK_USER_ID=


# ═══ MONITOREO Y VARIOS (opcional — tienen valores por defecto) ══════════════
# Cada cuántos minutos revisa Colorcito en busca de capítulos nuevos
CHECK_INTERVAL_MINUTES=25
# Zona horaria (formato IANA). Ej: America/Bogota, America/Mexico_City
TIMEZONE=America/Bogota
# URL base de Colorcito (cámbiala solo si la web cambia de dominio)
COLORCITO_BASE_URL=https://colorcitoscan.com


# ═══ WEBHOOK (opcional — solo si quieres recibir avisos de deploy externos) ══
# Déjalo VACÍO para correr en local: el servidor webhook no arrancará y no
# necesitarás abrir ningún puerto.
WEBHOOK_PORT=
WEBHOOK_SECRET=
